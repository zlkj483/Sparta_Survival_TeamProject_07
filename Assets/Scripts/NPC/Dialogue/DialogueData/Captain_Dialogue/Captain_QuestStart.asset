  m_Script: {fileID: 11500000, guid: c3891a7779740334d936a10a4d150291, type: 3}
  m_Name: Captain_QuestStart
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\uD574\uC801 \uCF54\uC2A4\uD504\uB808 \uD55C \uC911\uB144"
    text: "\uBC18\uAC00\uC6CC \uC774 \uB9C8\uC744\uC5D4 \uCC98\uC74C\uC778\uAC00\uBCF4\uC9C0?\n\uC544\uB2C8
      \uC774 \uC138\uACC4\uC5D0 \uCC98\uC74C\uC778\uAC00?"
  - speakerName: "\uD574\uC801 \uCF54\uC2A4\uD504\uB808 \uD55C \uC911\uB144"
    text: "\uADF8\uB807\uB2E4\uBA74 \uC774 \uC138\uACC4\uC5D0 \uB300\uD574\uC11C
      \uC870\uAE08 \uC54C\uB824\uC8FC\uACA0\uB124."
  - speakerName: "\uD574\uC801 \uCF54\uC2A4\uD504\uB808 \uD55C \uC911\uB144"
    text: "\uC6B0\uC120 \uAE38\uAC00\uC5D0 \uBCF4\uC774\uB294 \uC624\uBE0C\uC81D\uD2B8\uB97C
      E\uD0A4\uB97C \uB20C\uB7EC \uB108\uC758 \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uB123\uC744
      \uC218 \uC788\uC9C0"
  - speakerName: "\uD574\uC801 \uCF54\uC2A4\uD504\uB808 \uD55C \uC911\uB144"
    text: "\uADF8\uB807\uB2E4\uACE0 \uC544\uBB34 \uC624\uBE0C\uC81D\uD2B8\uB098 \uB2E4
      \uB123\uC744 \uC21C \uC788\uB294\uAC8C \uC544\uB2C8\uC57C\n\uC778\uBCA4\uD1A0\uB9AC\uC5D0
      \uB123\uC744 \uC218 \uC788\uB294 \uC624\uBE0C\uC81D\uD2B8\uB294 \uC544\uB9C8
      \uD654\uBA74\uC5D0 \uD45C\uC2DC\uAC00 \uB420\uAC78\uC138\n\uC624\uBE0C\uC81D\uD2B8\uC5D0
      \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uBA74 \uD45C\uC2DC\uAC00 \uB730\uAC70\uC57C."
  - speakerName: "\uD574\uC801 \uCF54\uC2A4\uD504\uB808 \uD55C \uC911\uB144"
    text: "\uC790 \uC54C\uC544\uB4E4\uC5C8\uC73C\uBA74 \uC2DC\uD5D8\uC0BC\uC544 \uB3CC\uBA69\uC774
      3\uAC1C\uB97C \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uB123\uC5B4\uC640\uBCF4\uAC8C"
