  lines:
  - speakerName: "\uB3C4\uB07C\uB97C \uB4E0 \uCCAD\uB144"
    text: "\uC18C\uC2DD \uB4E4\uC5C8\uC5B4? \n\uC655\uC790\uB2D8\uC774 \uB0A9\uCE58\uB2F9\uD588\uB2E4\uB294\uB370?(Z\uD0A4\uB85C
      \uB118\uC5B4\uAC00\uAE30)"
  - speakerName: "\uB3C4\uB07C\uB97C \uB4E0 \uCCAD\uB144"
    text: "\uC655\uC790\uB2D8\uC744 \uAD6C\uD558\uACE0 \uC2F6\uC73C\uBA74 \uB9C8\uBB3C\uB4E4\uC744
      \uBB3C\uB9AC\uCCD0\uC57C\uD55C\uB300."
  - speakerName: "\uB3C4\uB07C\uB97C \uB4E0 \uCCAD\uB144"
    text: "\uC6B0\uC120 \uC8FC\uBCC0\uC758 NPC\uB4E4\uC5D0\uAC8C \uD018\uC2A4\uD2B8\uB97C
      \uBC1B\uACE0 \uC774 \uC138\uACC4\uC5D0 \uB300\uD574 \uC54C\uC544\uAC00\uBCF4\uB294\uAC8C
      \uC88B\uC544."
